    "@modelcontextprotocol/sdk": "^1.30.0",
    "@strands-agents/sdk": "^1.12.0",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "node-pty": "^1.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
