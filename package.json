{
  "name": "darwin",
  "version": "0.0.1",
  "description": "TUI coding agent built on the Strands TypeScript SDK",
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "bin": {
    "darwin": "./dist/src/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node -e \"const fs=require('node:fs');fs.cpSync('src/skills/builtin','dist/src/skills/builtin',{recursive:true})\"",
    "start": "tsx src/cli.ts",
    "dev-repl": "tsx src/dev-repl.ts",
    "test": "tsx spike/run-tests.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiehust/strands-darwin.git"
  },
  "homepage": "https://github.com/xiehust/strands-darwin#readme",
  "bugs": {
    "url": "https://github.com/xiehust/strands-darwin/issues"
  },
  "dependencies": {
    "@aws/bedrock-token-generator": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@strands-agents/sdk": "^1.12.0",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.1",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "node-pty": "^1.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
