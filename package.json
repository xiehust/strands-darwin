{
  "name": "darwin",
  "version": "0.1.0",
  "description": "TUI coding agent built on the Strands TypeScript SDK",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "darwin": "./dist/src/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "tsx src/cli.ts",
